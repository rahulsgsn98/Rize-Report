{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "paths": {
      "@pages/*": ["./pages/*"],
      "@utils/*": ["./utils/*"],
      "@tests/*": ["./tests/*"],
      "@config": ["./test.config.ts"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "**/*.ts"]
}
